# =============================================================================
# LinkedIn Automation Platform - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ===== REQUIRED FOR V1 =====

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# LinkedIn OAuth (get from https://developer.linkedin.com)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key

# AI Comment Generation (optional but recommended)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ===== OPTIONAL =====

# API Server
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Token Monitor
ENABLE_TOKEN_MONITOR=true

# OpenAI (alternative to Anthropic)
OPENAI_API_KEY=sk-your-openai-api-key

# Redis (optional for V1)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL (if not using Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/linkedin_automation

# Logging
LOG_LEVEL=INFO

# ===== PRODUCTION ONLY =====

# Sentry Error Tracking
SENTRY_DSN=

# Rate Limiting
LINKEDIN_MAX_REQUESTS_PER_WINDOW=500
LINKEDIN_RATE_LIMIT_WINDOW=900

# =============================================================================
# CURRENT STACK (Railway deploy: multi-tenant API + SPA, Clerk, OpenRouter)
# These are what the running app actually reads. Set them as Railway service
# variables. Nothing here is required to boot in demo mode.
# =============================================================================

# --- Database: Railway Postgres plugin sets DATABASE_URL automatically. ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Quick no-Postgres trial instead: USE_SQLITE=true
# Schema is provisioned by Alembic: `python scripts/migrate.py` runs before the
# server in the Docker/Railway start command, and adopts a pre-Alembic database
# automatically. Leave AUTO_CREATE_TABLES off in any deployed environment.
AUTO_CREATE_TABLES=false         # local-only shortcut: build tables from the models

# --- Redis: Railway Redis plugin sets REDIS_URL. Optional; without it campaign
#     execution degrades gracefully rather than failing. ---
# REDIS_URL=redis://default:pass@host:6379/0

# --- Clerk auth (backend verifies session JWTs against JWKS) ---
# CLERK_JWKS_URL=https://<subdomain>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<subdomain>.clerk.accounts.dev
# CLERK_AUDIENCE=
# Frontend Clerk key (build-time). Unset => SPA runs in demo mode (no login).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- OpenRouter (all LLM inference; two configurable model slots) ---
# OPENROUTER_API_KEY=sk-or-xxx
# OPENROUTER_CONTENT_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_CLASSIFICATION_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Transport ---
# MOBILE_TRANSPORT_ENABLED=true

# --- Outreach slice (accounts, targeting, approvals) ---
# REQUIRED to connect a LinkedIn account: credentials are Fernet-encrypted at
# rest with this key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
# Local dev only -- uses a fixed insecure key so you can run without setting one.
# ALLOW_INSECURE_DEV_ENCRYPTION=false
#
# Sending is refused when Redis is absent, because the per-account daily caps
# cannot be enforced globally without it. Override only if you understand that
# this removes the cap enforcement:
# ALLOW_UNCAPPED_SENDING=false

# --- Warm-up programme ---
# New accounts enter the warm-up programme automatically and cannot send
# invitations until they have earned it (~21 days minimum). There is no env
# var to skip it; use POST /api/v1/warmup/accounts/{id}/stage if an account
# has genuine existing history and doesn't need the full ramp.

# --- Scheduler (what makes the programme autonomous) ---
# Nothing happens on a tick unless this is on. Run it as its own process:
#   python -m src.scheduler
#
# OFF BY DEFAULT, deliberately: it drives real activity on real LinkedIn
# accounts, and the mobile transport has not been validated against a live
# account yet. Turning it on has to be a decision, not an inherited default.
# SCHEDULER_ENABLED=false
#
# Sweep every account, report what would happen, execute nothing. Needs no
# Redis (nothing is executed, so there is no cap to enforce). This is the safe
# way to see what the scheduler thinks before letting it act.
# SCHEDULER_DRY_RUN=false
#
# Host the scheduler inside the API process instead of running a second one.
# For local development only: in production every web replica would bring its
# own ticker. (The Redis lease prevents duplicate activity regardless, but a
# design that avoids the situation beats one that relies on the guard.)
# SCHEDULER_IN_PROCESS=false
#
# How often to sweep. Ticks are cheap when nothing is due -- both the warm-up
# runner and the sender return on a DB-only path -- so this is set for send
# responsiveness rather than to save work.
# SCHEDULER_INTERVAL_SECONDS=300
#
# Reply/acceptance sync runs on its own slower clock, because unlike the other
# two stages it always costs LinkedIn requests and can never return early.
# SCHEDULER_SYNC_INTERVAL_SECONDS=1800
#
# Pacing. Every account acting the instant a tick begins is a signature, and so
# are ticks landing on exact multiples of the interval forever.
# SCHEDULER_ACCOUNT_SPACING_SECONDS=5
# SCHEDULER_JITTER_RATIO=0.1
#
# Ceiling on approved suggestions executed per account per sweep.
# SCHEDULER_SEND_LIMIT=10
#
# NOTE: a live scheduler REQUIRES Redis and does not honour
# ALLOW_UNCAPPED_SENDING. That override exists for a human pressing a button;
# extending it to an unattended loop is a different decision, and an uncapped
# autonomous sender is exactly how an account gets restricted.
